language js

// Ports eslint-plugin-expo's no-dynamic-env-var and no-env-var-destructuring.
// Metro inlines only static `process.env.EXPO_PUBLIC_NAME` member reads; every
// other shape of read is undefined in the shipped bundle.
//
// Destructuring is matched on Biome's syntax nodes rather than on code
// snippets so that one pattern covers each form: a declarator covers `const`,
// `let` and `var` alike, and an assignment covers `({ A } = process.env)`,
// which a `{ $props } = process.env` snippet does not reach (it parses as a
// declarator).
or {
  `process.env[$key]` as $read where {
    register_diagnostic(span=$read, message="Read EXPO_PUBLIC_* variables as static `process.env.EXPO_PUBLIC_NAME` member expressions: Metro only inlines static reads, so a computed `process.env[...]` is undefined in the shipped bundle (port of eslint-plugin-expo no-dynamic-env-var).")
  },
  JsVariableDeclarator(id=$id, initializer=$init) as $read where {
    $id <: JsObjectBindingPattern(),
    $init <: JsInitializerClause(expression=`process.env`),
    register_diagnostic(span=$read, message="Do not destructure process.env: Metro only inlines static `process.env.EXPO_PUBLIC_NAME` reads, so destructured variables are undefined in the shipped bundle (port of eslint-plugin-expo no-env-var-destructuring).")
  },
  JsAssignmentExpression(left=$left, right=$right) as $read where {
    $left <: JsObjectAssignmentPattern(),
    $right <: `process.env`,
    register_diagnostic(span=$read, message="Do not destructure process.env, by declaration or by assignment: Metro only inlines static `process.env.EXPO_PUBLIC_NAME` reads, so destructured variables are undefined in the shipped bundle (port of eslint-plugin-expo no-env-var-destructuring).")
  }
}
