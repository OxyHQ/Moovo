{
  "name": "moovo-monorepo",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Moovo: courier and transport platform by Oxy. Packages, food and moves, fulfilled by Moovo couriers or external providers.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:frontend": "bun run --filter @moovo/frontend dev -- --clear --tunnel",
    "dev:backend": "bun run --filter @moovo/backend dev",
    "build": "bun run build:shared-types && bun run build:backend && bun run build:frontend",
    "build:shared-types": "bun run --filter @moovo/shared-types build",
    "build:frontend": "bun run --filter @moovo/frontend build",
    "dev:courier": "bun run --filter @moovo/courier-app dev",
    "build:courier": "bun run --filter @moovo/courier-app build",
    "dev:hub": "bun run --filter @moovo/fleet-dashboard dev",
    "build:hub": "bun run --filter @moovo/fleet-dashboard build",
    "dev:tracker": "bun run --filter @moovo/tracker-app dev",
    "build:tracker": "bun run --filter @moovo/tracker-app build",
    "build:backend": "bun run build:shared-types && bun run build:contracts && bun run --filter @moovo/backend build",
    "start:frontend": "bun run --filter @moovo/frontend start",
    "start:backend": "bun run --filter @moovo/backend start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "doctor:oxy": "oxy-doctor --ci",
    "android": "bun run --filter @moovo/frontend android",
    "ios": "bun run --filter @moovo/frontend ios",
    "web": "bun run --filter @moovo/frontend web",
    "postinstall": "bun run build:shared-types && bun run build:contracts",
    "test:worker": "bun test scripts/asset-worker.test.ts",
    "check:api-entrypoints": "bun run build:backend && bun scripts/check-api-entrypoints.ts",
    "build:contracts": "bun run --filter @oxy.so/moovo-contracts build",
    "build:sdk": "bun run --filter @oxy.so/moovo-sdk build"
  },
  "keywords": [
    "monorepo",
    "marketplace",
    "expo",
    "api",
    "ecommerce"
  ],
  "author": "",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@oxy.so/doctor": "1.1.1",
    "postgres": "^3.4.9",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lightningcss": "1.30.1",
    "react-native-css": "3.1.0-rc.0",
    "markdown-it": "12.3.2",
    "lightningcss-linux-x64-gnu": "1.30.1",
    "lightningcss-linux-x64-musl": "1.30.1",
    "@oxy.so/bloom": "13.0.0",
    "@oxy.so/contracts": "5.0.0",
    "@oxy.so/core": "6.0.0",
    "@oxy.so/services": "11.16.0",
    "@oxy.so/protocol": "1.4.0"
  },
  "dependencies": {
    "@oxy.so/bloom": "13.0.0",
    "@oxy.so/contracts": "5.0.0",
    "@oxy.so/core": "6.0.0",
    "@oxy.so/services": "11.16.0"
  }
}
