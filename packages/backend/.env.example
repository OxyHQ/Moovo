# ================================
# DATABASE
# ================================
# PostgreSQL connection string. This is the service's ONLY store, and
# `db/postgres.ts` refuses to open without it rather than defaulting to a local
# server — a default makes a misconfigured task boot, report healthy-ish and
# fail every request.
#
# Local (docker-compose.postgres.yml): postgres://moovo:moovo@127.0.0.1:5437/moovo
DATABASE_URL=postgres://moovo:moovo@127.0.0.1:5437/moovo

# ================================
# API SERVER
# ================================
# Port the API listens on.
PORT=3001

# Web app origin (for CORS).
WEB_URL=http://localhost:3000

# ================================
# OXY AUTH
# ================================
# Base URL of the Oxy API used to validate sessions/service tokens.
OXY_API_URL=https://api.oxy.so

# Optional internal service secret (server-to-server calls). Generate with:
#   openssl rand -hex 32
# SERVICE_SECRET=

# Optional secret for the trusted internal bot auth helper. Generate with:
#   openssl rand -hex 32
# TELEGRAM_BOT_SECRET=

# ================================
# REDIS (optional)
# ================================
# Enables the Redis-backed rate-limit store and Socket.IO scaling. Without it,
# the app falls back to in-memory (per-instance) behavior.
# Local:   redis://localhost:6379
# Managed: rediss://user:password@host:port
# REDIS_URL=

# Optional CA cert (PEM) for TLS connections to managed Redis. `CA_CERT` is the
# fallback `lib/redis.ts` reads when `REDIS_CA_CERT` is unset — it is a live
# variable, not a leftover.
# REDIS_CA_CERT=
# CA_CERT=

# ================================
# WEB PUSH (optional)
# ================================
# VAPID keys for browser push notifications. Generate with:
#   bunx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@moovo.now

# ================================
# MOOVO TRACKER
# ================================
# Whether the poll dispatcher runs at all. It needs BOTH this flag and at least
# one registered adapter that can actually fetch: a poller enabled with no
# fetching adapter claims every due row and fails it into backoff, which from
# outside looks exactly like every carrier being down at once.
# TRACKING_ENABLED=false

# FedEx Track API. BOTH halves or neither — with only one set, the FedEx carrier
# stays deep-link-only, which is the shipped default and a working product, not
# a degraded one. `apis-sandbox.fedex.com` is a different HOST rather than a
# flag; a sandbox key against production auth fails with a 401 that reads
# exactly like a revoked credential.
#
# Setting these is NOT sufficient to start polling FedEx: the `fedex` row's
# `poll_supported` column is what the product reads, seeding is
# ON CONFLICT DO NOTHING, and an operator flips it AFTER one live call has
# confirmed the response mapping. See `services/tracking/adapters/fedex.ts`.
# FEDEX_CLIENT_ID=
# FEDEX_CLIENT_SECRET=
# FEDEX_BASE_URL=https://apis.fedex.com

# ================================
# LOGGING
# ================================
# LOG_LEVEL=info

# ================================
# NOTES
# ================================
# - Copy this file to .env and fill in your values.
# - Never commit .env to version control.
