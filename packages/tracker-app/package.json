{
  "name": "@moovo/tracker-app",
  "main": "index",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --clear --tunnel",
    "dev": "expo start --scheme moovotracker",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "bun x expo export --platform web && bun run build:edge",
    "build:production": "NODE_ENV=production bun x expo export --platform web --clear && bun run build:edge",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:edge": "bun build worker/index.js --target=browser --format=esm --outfile=dist/_worker.js"
  },
  "dependencies": {
    "@expo/html-elements": "^0.13.8",
    "@expo/vector-icons": "^15.1.1",
    "@moovo/shared-types": "workspace:*",
    "@oxy.so/app-preset": "^3.4.0",
    "@oxy.so/bloom": "15.8.2",
    "@oxy.so/core": "6.14.0",
    "@oxy.so/services": "12.12.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.100.0",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "lightningcss": "1.30.1",
    "nativewind": "5.0.0-rc.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-css": "3.1.0-rc.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "4.2.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.2.3",
    "typescript": "~6.0.3"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.2",
    "@unrs/resolver-binding-linux-x64-gnu": "^1.11.1",
    "lightningcss-linux-x64-gnu": "1.30.1"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native-safe-area-context",
        "react-native-svg"
      ]
    }
  }
}
