    "@oxy.so/services": "^1.0.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.100.0",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "expo": "^56.0.11",
    "expo-asset": "~56.0.17",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-font": "~56.0.6",
