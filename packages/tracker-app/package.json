{
  "name": "@moovo/tracker-app",
  "main": "index",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --clear --tunnel",
    "dev": "expo start --scheme moovotracker",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "bun x expo export --platform web && bun run build:edge",
    "build:production": "NODE_ENV=production bun x expo export --platform web --clear && bun run build:edge",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:edge": "bun build worker/index.js --target=browser --format=esm --outfile=dist/_worker.js"
  },
  "dependencies": {
    "@expo/html-elements": "^0.13.8",
    "@expo/vector-icons": "^15.1.1",
    "@moovo/shared-types": "workspace:*",
    "@oxy.so/app-preset": "^3.1.0",
    "@oxy.so/bloom": "^10.17.0",
    "@oxy.so/core": "5.0.0",
    "@oxy.so/services": "^11.13.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.100.0",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "expo": "^57.0.29",
    "expo-asset": "~57.0.20",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "lightningcss": "1.30.1",
    "nativewind": "5.0.0-rc.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "3.1.0-rc.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "4.2.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@tailwindcss/postcss": "4.2.2",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.3",
    "babel-plugin-module-resolver": "^5.0.3",
    "typescript": "~5.9.2"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.2",
    "@unrs/resolver-binding-linux-x64-gnu": "^1.11.1",
    "lightningcss-linux-x64-gnu": "1.30.1"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native-safe-area-context",
        "react-native-svg"
      ]
    }
  }
}
