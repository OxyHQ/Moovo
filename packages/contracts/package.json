{
  "name": "@oxy.so/moovo-contracts",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/Moovo.git",
    "directory": "packages/contracts"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
