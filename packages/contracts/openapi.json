  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CreateTransport": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "actingAccountId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "payerAccountId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "operationId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "pickup": {
            "type": "object",
            "properties": {
              "address": {
                "type": "object",
                "properties": {
                  "line1": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 250
                  },
                  "line2": {
                    "type": "string",
                    "maxLength": 250
                  },
                  "city": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "region": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "postalCode": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  },
                  "country": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  }
                },
                "required": ["line1", "city", "postalCode", "country"],
                "additionalProperties": false
              },
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "contactName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "contactPhone": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "notes": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": ["address", "latitude", "longitude", "contactName", "contactPhone"],
            "additionalProperties": false
          },
          "dropoff": {
            "type": "object",
            "properties": {
              "address": {
                "type": "object",
                "properties": {
                  "line1": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 250
                  },
                  "line2": {
                    "type": "string",
                    "maxLength": 250
                  },
                  "city": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "region": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "postalCode": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  },
                  "country": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  }
                },
                "required": ["line1", "city", "postalCode", "country"],
                "additionalProperties": false
              },
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "contactName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "contactPhone": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "notes": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": ["address", "latitude", "longitude", "contactName", "contactPhone"],
            "additionalProperties": false
          },
          "parcel": {
