{
  "name": "@moovo/fleet-dashboard",
  "main": "index",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --clear --tunnel",
    "dev": "expo start --scheme moovohub",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "generate-sitemap": "bun scripts/generate-sitemap.ts",
    "prebuild": "bun run generate-sitemap",
    "build": "bun x expo export --platform web && bun run build:edge",
    "build:production": "NODE_ENV=production bun x expo export --platform web --clear && bun run build:edge",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:edge": "bun build worker/index.js --target=browser --format=esm --outfile=dist/_worker.js"
  },
  "dependencies": {
    "@expo/html-elements": "^0.13.8",
