{
  "name": "@oxy.so/moovo-sdk",
  "version": "0.2.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/Moovo.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
