        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "esbuild": "^0.28.2",
    "rollup": "^4.59.0",
    "rollup-plugin-dts": "~6.4.1",
    "@oxy.so/moovo-contracts": "workspace:*"
  },
  "peerDependencies": {
    "@oxy.so/core": "^4.5.0 || ^5.0.0 || ^6.0.0"
  }
